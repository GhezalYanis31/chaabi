---
import { RUBRIQUES } from '../data/rubriques';

interface Props {
  actif?: string;
}
const { actif } = Astro.props;

const liens = [
  ...RUBRIQUES.map((r) => ({ href: `/${r.slug}/`, cle: r.slug, nom: r.nom })),
  { href: '/a-propos/', cle: 'a-propos', nom: 'À propos' },
];
---

<header class="tete">
  <div class="cadre tete-ligne">
    <a class="marque" href="/" aria-label="CHAABI, retour à l’accueil">CHAABI</a>
    <nav class="navigation" aria-label="Rubriques">
      {
        liens.map((l) => (
          <a href={l.href} class:list={{ actif: l.cle === actif }} aria-current={l.cle === actif ? 'page' : undefined}>
            {l.nom}
          </a>
        ))
      }
    </nav>
    <div class="tete-actions">
      <a class="lien-lettre" href="#lettre">La lettre</a>
      <button class="bouton-theme" id="bouton-theme" type="button" aria-label="Changer de thème (clair ou sombre)" title="Clair / sombre">
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M10 1.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
