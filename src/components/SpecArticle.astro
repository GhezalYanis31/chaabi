---
import Spec from './Spec.astro';
import { rubriqueParSlug } from '../data/rubriques';
import { dateFr, pluriel, signes, tempsDeLecture, type Article } from '../lib/articles';

interface Props {
  article: Article;
}
const { article } = Astro.props;
const d = article.data;
---

<Spec
  paires={[
    { libelle: 'Rubrique', texte: rubriqueParSlug(d.rubrique)?.nom, lien: `/${d.rubrique}/` },
    { libelle: 'Parution', texte: dateFr(d.date) },
    { libelle: 'Longueur', texte: pluriel(signes(article.body), 'signe') },
    { libelle: 'Lecture', texte: `${tempsDeLecture(article.body)} min` },
    { libelle: 'Signature', texte: d.auteur },
    d.brouillon
      ? { libelle: 'Statut', texte: 'Brouillon', italique: true }
      : d.exemple
        ? { libelle: 'Statut', texte: 'Exemple, gabarit à remplacer', italique: true }
        : null,
  ]}
/>
