---
import Base from '../layouts/Base.astro';
import Fleche from '../components/Fleche.astro';
---

<Base titre="Merci">
  <section class="planche">
    <div class="cadre specimen">
      <div class="message">
        <h1 class="titre-specimen moyen compose">C’est noté, merci.</h1>
        <p>Vous recevrez la prochaine newsletter au début du mois.</p>
        <a class="lire" href="/">
          Retour à l’accueil
          <Fleche />
        </a>
      </div>
    </div>
  </section>
</Base>
